# ---------------------------------------------------------------------------
# agentteam configuration.  Copy to ".env" and adjust.
# ---------------------------------------------------------------------------

# LLM provider for every agent: "mock" (fully offline, no API key) or "openai"
# (any OpenAI-compatible endpoint, e.g. Azure/DeepSeek/vLLM/Ollama).
AGENT_LLM_PROVIDER=mock

# --- OpenAI-compatible endpoint (used when AGENT_LLM_PROVIDER=openai) -------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Local Ollama example:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5-coder:14b

# --- Per-role model overrides (this is what makes it a *multi-model* team) --
# Any role may use a different provider / endpoint / model / temperature.
# AGENT_PLANNER_MODEL=gpt-4o
# AGENT_PLANNER_TEMPERATURE=0.2
# AGENT_ACTOR_MODEL=qwen2.5-coder:14b
# AGENT_ACTOR_BASE_URL=http://localhost:11434/v1
# AGENT_ACTOR_API_KEY=ollama
# AGENT_REVIEWER_MODEL=gpt-4o
# AGENT_TESTER_MODEL=gpt-4o-mini

# --- Message bus -----------------------------------------------------------
# auto | memory | redis     (auto = try Redis, fall back to in-process bus)
AGENT_BUS=auto
REDIS_URL=redis://localhost:6379/0

# --- Runtime limits --------------------------------------------------------
AGENT_MAX_ROUNDS=3
AGENT_MAX_TOOL_STEPS=8
AGENT_SESSION_TIMEOUT=300
AGENT_SHELL_TIMEOUT=120

# --- Paths (defaults are <project>/workspace and <project>/runs) -----------
# AGENT_WORKSPACE=workspace
# AGENT_RUNS_DIR=runs
